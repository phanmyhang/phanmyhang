---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import ShareButton from '../components/ShareButton.astro';
import { profile } from '../data/profile';

const description = profile.descriptionLines.join(' ');
const pageTitle = `${profile.name} | Instagram, TikTok, Facebook`;
---

<BaseLayout title={pageTitle} description={description} image={profile.avatar}>
  <main class="page">
    <section class="panel">
      <div class="topbar">
        <span class="topbar-spacer"></span>
        <ShareButton name={profile.name} />
      </div>

      <ProfileHeader profile={profile} />

      <div class="links">
        {profile.links.map((link) => <LinkCard link={link} />)}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page {
    display: flex;
    justify-content: center;
    min-height: 100vh;
    padding: 0;
  }

  .panel {
    position: relative;
    width: 100%;
    max-width: 580px;
    min-height: 100vh;
    background: var(--color-panel-bg);
    padding: 1rem 1.25rem 3rem;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topbar-spacer {
    width: 40px;
    height: 40px;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
    width: 100%;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 600px) {
    .panel {
      max-width: 580px;
    }
  }
</style>
