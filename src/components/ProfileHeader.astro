---
import SocialIcons from './SocialIcons.astro';
import { withBase } from '../utils/url';
import type { Profile } from '../data/profile';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<header class="profile">
  <div class="avatar-wrap">
    <img
      class="avatar"
      src={withBase(profile.avatar)}
      alt={`Ảnh đại diện của ${profile.name}`}
      width="96"
      height="96"
      loading="eager"
    />
  </div>

  <h1 class="profile-title">{profile.title}</h1>

  <div class="profile-desc">
    {profile.descriptionLines.map((line) => <p>{line}</p>)}
  </div>

  <SocialIcons socials={profile.socials} />
</header>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 1.5rem;
  }

  .avatar-wrap {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .profile-title {
    font-size: 1.5rem;
    font-weight: 400;
    margin: 1rem 0 0.5rem;
    color: var(--color-text);
    letter-spacing: 0.5px;
  }

  .profile-desc {
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    max-width: 22rem;
  }

  .profile-desc p {
    margin: 0;
  }
</style>
